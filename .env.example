# IABTM Sensei MVP
# The curator does not use these. /api/curator, /api/ingest, /api/catalog, and /api/media
# run with no login and no keys. Home, onboard, and Sensei need the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional. If unset, Sensei uses the browser's speech synthesis for visualizations.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
